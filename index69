    <script>
        // Google Sheet Spreadsheet ID & Export URLs
        const SPREADSHEET_ID = '1soLiU3h5RO18p7l7xXv2lPlZUQOQUGsNbiXRT3NXjxM';
        const PRIMARY_CSV_URL = `https://docs.google.com/spreadsheets/d/${SPREADSHEET_ID}/gviz/tq?tqx=out:csv`;
        const FALLBACK_CSV_URL = `https://docs.google.com/spreadsheets/d/${SPREADSHEET_ID}/pub?output=csv`;

        // Mock Fallback Data (กรณีดึงจาก Google Sheet ไม่ได้เนื่องจากติดสิทธิ์การแชร์)
        const MOCK_DATA = [
            { province: 'กรุงเทพมหานคร', lat: 13.7563, lng: 100.5018, disease: 'ไข้เลือดออก', total_cases: 245, new_cases: 18, recovered: 180, bed_occupancy: 82.5, age_group: '15-30 ปี' },
            { province: 'เชียงใหม่', lat: 18.7883, lng: 98.9853, disease: 'ไข้เลือดออก', total_cases: 120, new_cases: 9, recovered: 95, bed_occupancy: 64.0, age_group: '0-14 ปี' },
            { province: 'ขอนแก่น', lat: 16.4322, lng: 102.8236, disease: 'COVID-19', total_cases: 185, new_cases: 12, recovered: 150, bed_occupancy: 71.2, age_group: '60 ปีขึ้นไป' },
            { province: 'ชลบุรี', lat: 13.3611, lng: 100.9847, disease: 'ไข้หวัดใหญ่', total_cases: 95, new_cases: 5, recovered: 80, bed_occupancy: 55.0, age_group: '31-45 ปี' },
            { province: 'ภูเก็ต', lat: 7.8804, lng: 98.3923, disease: 'ไข้เลือดออก', total_cases: 68, new_cases: 4, recovered: 58, bed_occupancy: 48.0, age_group: '15-30 ปี' },
            { province: 'นครราชสีมา', lat: 14.9799, lng: 102.0978, disease: 'COVID-19', total_cases: 142, new_cases: 8, recovered: 110, bed_occupancy: 68.4, age_group: '46-60 ปี' },
            { province: 'สงขลา', lat: 7.1988, lng: 100.5951, disease: 'มือเท้าปาก', total_cases: 45, new_cases: 3, recovered: 40, bed_occupancy: 38.0, age_group: '0-14 ปี' },
            { province: 'อุบลราชธานี', lat: 15.2448, lng: 104.8473, disease: 'ไข้หวัดใหญ่', total_cases: 88, new_cases: 6, recovered: 72, bed_occupancy: 52.1, age_group: '0-14 ปี' }
        ];

        let rawData = [];
        let filteredData = [];
        let map = null;
        let mapMarkers = [];
        let diseaseChartObj = null;
        let ageChartObj = null;
        let trendChartObj = null;

        // Start Application after Page Load
        window.onload = function() {
            initMap();
            initCharts();
            fetchData();

            // Auto refresh every 30 seconds
            setInterval(fetchData, 30000);
        };

        // Initialize Leaflet GIS Map using Esri ArcGIS World Services
        function initMap() {
            // Center of Thailand
            map = L.map('map', {
                center: [13.736717, 100.523186],
                zoom: 6,
                zoomControl: true
            });

            // Primary Tile Layer: Esri World Topo Map
            const esriWorldTopo = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}', {
                attribution: 'Tiles &copy; Esri &mdash; Esri, DeLorme, NAVTEQ, TomTom, Intermap, iPC, USGS, FAO, NPS, NRCAN, GeoBase, IGN, Kadaster NL, Ordnance Survey, Esri Japan, METI, Esri China (Hong Kong), swisstopo, MapmyIndia, &copy; OpenStreetMap contributors',
                maxZoom: 18
            });

            // Secondary Layer: Esri World Imagery (ภาพถ่ายดาวเทียม)
            const esriWorldImagery = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
                attribution: 'Tiles &copy; Esri &mdash; Source: Esri, i-cubed, USDA, USGS, AEX, GeoEye, Getmapping, Aerogrid, IGN, IGP, UPR-EGP, and the GIS User Community',
                maxZoom: 18
            });

            // World Canvas Light (โทนสว่างสำหรับการนำเสนอข้อมูลเชิงสถิติ)
            const esriGrayCanvas = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Light_Gray_Base/MapServer/tile/{z}/{y}/{x}', {
                attribution: 'Tiles &copy; Esri &mdash; Esri, DeLorme, NAVTEQ',
                maxZoom: 16
            });

            // Add Default Layer
            esriWorldTopo.addTo(map);

            // Layer Control to switch maps
            const baseMaps = {
                "Esri Topo Map (แผนที่ภูมิประเทศ)": esriWorldTopo,
                "Esri Gray Canvas (แผนที่สีเทาสบายตา)": esriGrayCanvas,
                "Esri Satellite (ภาพดาวเทียม)": esriWorldImagery
            };

            L.control.layers(baseMaps).addTo(map);

            // Trigger resize to fix tile render glitch if wrapped in flex/grid
            setTimeout(() => {
                map.invalidateSize();
            }, 300);
        }

        // Fetch Data from Google Sheet CSV or Fallback using native fetch API
        async function fetchData() {
            const refreshIcon = document.getElementById('refresh-icon');
            if (refreshIcon) refreshIcon.classList.add('fa-spin');

            try {
                let response = await fetch(PRIMARY_CSV_URL);
                if (!response.ok) {
                    response = await fetch(FALLBACK_CSV_URL);
                }
                
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }

                const csvText = await response.text();

                Papa.parse(csvText, {
                    header: true,
                    skipEmptyLines: true,
                    complete: function(results) {
                        if (refreshIcon) refreshIcon.classList.remove('fa-spin');
                        if (results.data && results.data.length > 0) {
                            const processed = processParsedData(results.data);
                            if (processed.length > 0) {
                                rawData = processed;
                                showToast("เชื่อมต่อข้อมูลจาก Google Sheet สำเร็จ", "success");
                            } else {
                                rawData = MOCK_DATA;
                                showToast("ไม่พบโครงสร้างข้อมูลที่ถูกต้อง ใช้ข้อมูลจำลองแทน", "warning");
                            }
                        } else {
                            rawData = MOCK_DATA;
                            showToast("โหลดข้อมูลสำรอง (Mock Data) สำเร็จ", "info");
                        }
                        updateDashboard();
                    },
                    error: function(err) {
                        if (refreshIcon) refreshIcon.classList.remove('fa-spin');
                        console.warn("CSV Parsing error:", err);
                        rawData = MOCK_DATA;
                        showToast("ใช้ข้อมูลจำลองเนื่องจากรูปแบบข้อมูลไม่ถูกต้อง", "info");
                        updateDashboard();
                    }
                });
            } catch (error) {
                if (refreshIcon) refreshIcon.classList.remove('fa-spin');
                console.warn("Fetch failed, likely CORS or permission restriction. Falling back to Mock Data.", error);
                rawData = MOCK_DATA;
                showToast("ใช้ข้อมูลจำลอง (โปรดตรวจสอบการเผยแพร่ Google Sheet)", "info");
                updateDashboard();
            }
        }

        // Process and normalize parsed CSV data
        function processParsedData(data) {
            return data.map(item => {
                const normalized = {};
                Object.keys(item).forEach(k => {
                    if (k) normalized[k.trim().toLowerCase()] = item[k];
                });

                const province = normalized['province'] || normalized['จังหวัด'] || normalized['area'] || item.province || item['จังหวัด'];
                if (!province) return null;

                return {
                    province: province,
                    lat: parseFloat(normalized['lat'] || normalized['ละติจูด'] || normalized['latitude']) || 13.75,
                    lng: parseFloat(normalized['lng'] || normalized['ลองจิจูด'] || normalized['longitude']) || 100.50,
                    disease: normalized['disease'] || normalized['โรค'] || 'ไข้เลือดออก',
                    total_cases: parseInt(normalized['total_cases'] || normalized['ผู้ป่วยสะสม'] || normalized['cases']) || 0,
                    new_cases: parseInt(normalized['new_cases'] || normalized['ผู้ป่วยใหม่']) || 0,
                    recovered: parseInt(normalized['recovered'] || normalized['หายป่วย']) || 0,
                    bed_occupancy: parseFloat(normalized['bed_occupancy'] || normalized['อัตราครองเตียง']) || 50,
                    age_group: normalized['age_group'] || normalized['กลุ่มอายุ'] || '15-30 ปี'
                };
            }).filter(item => item !== null);
        }

        // Update All Dashboard Elements
        function updateDashboard() {
            populateFilterDropdowns();
            applyFilters();
            
            // Update Timestamp
            const now = new Date();
            document.getElementById('last-updated').innerText = now.toLocaleDateString('th-TH', { 
                day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit'
            }) + ' น.';
        }

        // Populate Dropdown Filters dynamically
        function populateFilterDropdowns() {
            const provinceSelect = document.getElementById('filter-province');
            const diseaseSelect = document.getElementById('filter-disease');

            const currentProv = provinceSelect.value;
            const currentDis = diseaseSelect.value;

            const provinces = [...new Set(rawData.map(d => d.province))].sort();
            const diseases = [...new Set(rawData.map(d => d.disease))].sort();

            provinceSelect.innerHTML = '<option value="ALL">ทุกพื้นที่ / ทุกจังหวัด</option>';
            provinces.forEach(p => {
                const opt = document.createElement('option');
                opt.value = p;
                opt.textContent = p;
                if (p === currentProv) opt.selected = true;
                provinceSelect.appendChild(opt);
            });

            diseaseSelect.innerHTML = '<option value="ALL">ทุกกลุ่มโรค / ภัยสุขภาพ</option>';
            diseases.forEach(d => {
                const opt = document.createElement('option');
                opt.value = d;
                opt.textContent = d;
                if (d === currentDis) opt.selected = true;
                diseaseSelect.appendChild(opt);
            });
        }

        // Apply Filters and re-render visual elements
        function applyFilters() {
            const selectedProvince = document.getElementById('filter-province').value;
            const selectedDisease = document.getElementById('filter-disease').value;

            filteredData = rawData.filter(d => {
                const matchProvince = (selectedProvince === 'ALL' || d.province === selectedProvince);
                const matchDisease = (selectedDisease === 'ALL' || d.disease === selectedDisease);
                return matchProvince && matchDisease;
            });

            renderKPIs(filteredData);
            renderMap(filteredData);
            renderCharts(filteredData);
            renderTable(filteredData);
        }

        function resetFilters() {
            document.getElementById('filter-province').value = 'ALL';
            document.getElementById('filter-disease').value = 'ALL';
            document.getElementById('table-search').value = '';
            applyFilters();
        }

        // Render Top Cards / KPIs
        function renderKPIs(data) {
            const totalCases = data.reduce((sum, d) => sum + d.total_cases, 0);
            const newCases = data.reduce((sum, d) => sum + d.new_cases, 0);
            const recovered = data.reduce((sum, d) => sum + d.recovered, 0);
            const avgBed = data.length > 0 ? (data.reduce((sum, d) => sum + d.bed_occupancy, 0) / data.length).toFixed(1) : 0;

            document.getElementById('stat-total-cases').innerText = totalCases.toLocaleString('th-TH');
            document.getElementById('stat-new-cases').innerText = '+' + newCases.toLocaleString('th-TH');
            document.getElementById('stat-recovered').innerText = recovered.toLocaleString('th-TH');
            document.getElementById('stat-bed-rate').innerText = avgBed + '%';

            // Bed Badge Color Dynamic Class
            const bedBadge = document.getElementById('stat-bed-badge');
            if (avgBed > 80) {
                bedBadge.className = 'text-xs font-medium text-rose-600 bg-rose-50 px-2 py-0.5 rounded-full';
                bedBadge.innerText = 'วิกฤต (ตึงตัวมาก)';
            } else if (avgBed > 60) {
                bedBadge.className = 'text-xs font-medium text-amber-600 bg-amber-50 px-2 py-0.5 rounded-full';
                bedBadge.innerText = 'เฝ้าระวัง';
            } else {
                bedBadge.className = 'text-xs font-medium text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-full';
                bedBadge.innerText = 'ปกติ';
            }
        }

        // Render Map Markers
        function renderMap(data) {
            if (!map) return;
            
            // Clear existing markers
            mapMarkers.forEach(m => map.removeLayer(m));
            mapMarkers = [];

            if (data.length === 0) return;

            const bounds = [];

            data.forEach(item => {
                if (!item.lat || !item.lng) return;

                let color = '#22c55e'; // Green low
                if (item.total_cases > 150) color = '#e11d48'; // Red high
                else if (item.total_cases >= 50) color = '#f59e0b'; // Amber medium

                const radius = Math.min(Math.max(item.total_cases / 8, 10), 30);

                const circle = L.circleMarker([item.lat, item.lng], {
                    color: color,
                    fillColor: color,
                    fillOpacity: 0.6,
                    radius: radius
                }).addTo(map);

                const popupContent = `
                    <div class="p-2 font-sans">
                        <h4 class="font-bold text-sm text-slate-800 border-b pb-1 mb-2">${item.province}</h4>
                        <div class="text-xs space-y-1">
                            <div><strong class="text-slate-600">โรค:</strong> ${item.disease}</div>
                            <div><strong class="text-slate-600">ผู้ป่วยสะสม:</strong> <span class="text-rose-600 font-bold">${item.total_cases.toLocaleString()}</span> คน</div>
                            <div><strong class="text-slate-600">รายใหม่:</strong> +${item.new_cases} คน</div>
                            <div><strong class="text-slate-600">หายป่วย:</strong> ${item.recovered} คน</div>
                            <div><strong class="text-slate-600">ครองเตียง:</strong> ${item.bed_occupancy}%</div>
                        </div>
                    </div>
                `;

                circle.bindPopup(popupContent);
                mapMarkers.push(circle);
                bounds.push([item.lat, item.lng]);
            });

            if (bounds.length > 0) {
                map.fitBounds(bounds, { padding: [30, 30], maxZoom: 10 });
            }
            
            // Re-invalidate size to ensure smooth tile rendering
            setTimeout(() => { map.invalidateSize(); }, 200);
        }

        // Initialize Charts with global configs
        function initCharts() {
            // Chart 1: Disease Doughnut
            const ctxDisease = document.getElementById('diseaseChart').getContext('2d');
            diseaseChartObj = new Chart(ctxDisease, {
                type: 'doughnut',
                data: { labels: [], datasets: [{ data: [], backgroundColor: ['#22c55e', '#3b82f6', '#f59e0b', '#ec4899', '#8b5cf6'] }] },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom', labels: { font: { family: 'Sarabun', size: 11 } } }
                    }
                }
            });

            // Chart 2: Age Bar Chart
            const ctxAge = document.getElementById('ageChart').getContext('2d');
            ageChartObj = new Chart(ctxAge, {
                type: 'bar',
                data: { labels: [], datasets: [{ label: 'จำนวนผู้ป่วย (คน)', data: [], backgroundColor: '#3b82f6', borderRadius: 6 }] },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: { y: { beginAtZero: true } }
                }
            });

            // Chart 3: Trend Line Chart
            const ctxTrend = document.getElementById('trendChart').getContext('2d');
            trendChartObj = new Chart(ctxTrend, {
                type: 'line',
                data: {
                    labels: ['ม.ค.', 'ก.พ.', 'มี.ค.', 'เม.ย.', 'พ.ค.', 'มิ.ย.', 'ก.ค.', 'ส.ค.', 'ก.ย.', 'ต.ค.'],
                    datasets: [
                        { label: 'เคสผู้ป่วยใหม่', data: [65, 78, 90, 115, 140, 180, 210, 195, 160, 130], borderColor: '#6366f1', backgroundColor: 'rgba(99, 102, 241, 0.1)', fill: true, tension: 0.3 },
                        { label: 'เคสจำหน่าย/หายป่วย', data: [50, 60, 85, 100, 120, 150, 190, 180, 150, 125], borderColor: '#14b8a6', backgroundColor: 'transparent', borderDash: [5, 5], tension: 0.3 }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: { y: { beginAtZero: true } }
                }
            });
        }

        // Render dynamic charts
        function renderCharts(data) {
            const diseaseCounts = {};
            data.forEach(d => {
                diseaseCounts[d.disease] = (diseaseCounts[d.disease] || 0) + d.total_cases;
            });

            diseaseChartObj.data.labels = Object.keys(diseaseCounts);
            diseaseChartObj.data.datasets[0].data = Object.values(diseaseCounts);
            diseaseChartObj.update();

            const ageCounts = {};
            data.forEach(d => {
                ageCounts[d.age_group] = (ageCounts[d.age_group] || 0) + d.total_cases;
            });

            ageChartObj.data.labels = Object.keys(ageCounts);
            ageChartObj.data.datasets[0].data = Object.values(ageCounts);
            ageChartObj.update();
        }

        // Render Data Table
        function renderTable(data) {
            const tbody = document.getElementById('table-body');
            tbody.innerHTML = '';

            if (data.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" class="px-5 py-6 text-center text-slate-400">ไม่พบข้อมูลตรงตามเงื่อนไขตัวกรอง</td></tr>`;
                document.getElementById('table-count-info').innerText = 'แสดง 0 รายการ';
                return;
            }

            data.forEach(item => {
                let riskBadge = '<span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-100 text-emerald-700">เสี่ยงต่ำ</span>';
                if (item.total_cases > 150) {
                    riskBadge = '<span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-rose-100 text-rose-700">เสี่ยงสูง</span>';
                } else if (item.total_cases >= 50) {
                    riskBadge = '<span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-amber-100 text-amber-700">ปานกลาง</span>';
                }

                const tr = document.createElement('tr');
                tr.className = 'hover:bg-slate-50/80 transition-colors';
                tr.innerHTML = `
                    <td class="px-5 py-3 font-semibold text-slate-800">${item.province}</td>
                    <td class="px-5 py-3">${item.disease}</td>
                    <td class="px-5 py-3 text-right font-bold text-slate-700">${item.total_cases.toLocaleString()}</td>
                    <td class="px-5 py-3 text-right text-rose-600 font-semibold">+${item.new_cases}</td>
                    <td class="px-5 py-3 text-right text-emerald-600 font-medium">${item.recovered}</td>
                    <td class="px-5 py-3 text-center">
                        <div class="flex items-center justify-center gap-2">
                            <div class="w-16 bg-slate-200 rounded-full h-1.5 overflow-hidden">
                                <div class="bg-blue-600 h-1.5 rounded-full" style="width: ${Math.min(item.bed_occupancy, 100)}%"></div>
                            </div>
                            <span class="text-[11px]">${item.bed_occupancy}%</span>
                        </div>
                    </td>
                    <td class="px-5 py-3 text-center">${riskBadge}</td>
                `;
                tbody.appendChild(tr);
            });

            document.getElementById('table-count-info').innerText = `แสดงข้อมูลทั้งหมด ${data.length} รายการ`;
        }

        // Table Live Search
        function searchTable() {
            const query = document.getElementById('table-search').value.toLowerCase();
            const searchFiltered = filteredData.filter(d => 
                d.province.toLowerCase().includes(query) || 
                d.disease.toLowerCase().includes(query)
            );
            renderTable(searchFiltered);
        }

        // Export Data to CSV
        function exportDataCSV() {
            if (!filteredData || filteredData.length === 0) {
                showToast("ไม่มีข้อมูลสำหรับส่งออก", "warning");
                return;
            }

            const csvContent = Papa.unparse(filteredData);
            const blob = new Blob([new Uint8Array([0xEF, 0xBB, 0xBF]), csvContent], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const link = document.createElement('a');
            link.setAttribute('href', url);
            link.setAttribute('download', `Public_Health_Report_${new Date().toISOString().slice(0,10)}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            showToast("ดาวน์โหลดไฟล์ CSV เรียบร้อย", "success");
        }

        // Toast Notification Helper
        function showToast(message, type = 'success') {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toast-message');
            const toastIcon = document.getElementById('toast-icon');

            if (!toast || !toastMsg || !toastIcon) return;

            toastMsg.innerText = message;
            
            if (type === 'success') toastIcon.className = 'fa-solid fa-circle-check text-emerald-400';
            else if (type === 'warning') toastIcon.className = 'fa-solid fa-triangle-exclamation text-amber-400';
            else toastIcon.className = 'fa-solid fa-circle-info text-blue-400';

            toast.classList.remove('translate-y-20', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');

            setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3000);
        }
    </script>
</body>
